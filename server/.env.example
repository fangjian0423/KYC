# ── Database ──────────────────────────────────────────────────────────────────
# Leave COSMOS_CONNECTION_STRING unset to fall back to local SQLite (kyc.db).
COSMOS_CONNECTION_STRING=AccountEndpoint=https://<your-account>.documents.azure.com:443/;AccountKey=<your-key>;
# USE_MOCK_DB=true   # force the in-memory mock repository
PORT=5000

# ── Document storage (Azure Blob) ─────────────────────────────────────────────
# Set STORAGE_ACCOUNT_NAME to persist uploaded document images in Blob Storage
# (auth via Managed Identity / az login). Leave unset to keep images inline
# (base64 in the DB) for local/mock runs.
# STORAGE_ACCOUNT_NAME=<your-storage-account>
# STORAGE_CONTAINER_NAME=kyc-documents

# ── Microsoft Foundry Agents platform ─────────────────────────────────────────
# Set FOUNDRY_PROJECT_ENDPOINT to run the real multi-agent pipeline (az login required).
# Leave it unset to use the built-in deterministic mock pipeline.
FOUNDRY_PROJECT_ENDPOINT=https://jimmy-test.services.ai.azure.com/api/projects/proj-default
FOUNDRY_MODEL_NAME=gpt-5.4

# ── Corporate registry (openapi.it) — auto-managed token ──────────────────────
# The UBO agent calls the registry via a function tool executed in our code, which
# exchanges the long-lived API key for short-lived tokens automatically (no manual
# rotation). Get a Sandbox API key from https://console.openapi.com (Test mode).
REGISTRY_API_KEY=
REGISTRY_EMAIL=
# Optional overrides (sensible sandbox defaults are built in):
# REGISTRY_TOKEN_ENDPOINT=https://test.oauth.openapi.it/token
# REGISTRY_BASE_URL=https://test.company.openapi.com
# REGISTRY_SCOPE=GET:test.company.openapi.com/WW-start

# ── Routine schedule (perpetual KYC) ──────────────────────────────────────────
# KYC_ROUTINE_CRON=0 8 * * 1
# KYC_ROUTINE_TZ=UTC

# ── Tracing / observability ───────────────────────────────────────────────────
# Connect an Application Insights resource to export agent + orchestration traces.
APPLICATIONINSIGHTS_CONNECTION_STRING=
