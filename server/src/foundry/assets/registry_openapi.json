{
  "openapi": "3.0.0",
  "info": {
    "title": "OpenAPI Sandbox Corporate Registry Gateway",
    "description": "Queries international business entity profiles and UBO verification records from the sandbox corporate registry.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://test.company.openapi.com",
      "description": "Sandbox Testing Environment"
    }
  ],
  "paths": {
    "/WW-start/{countryCode}/{registrationNumber}": {
      "get": {
        "summary": "Retrieve Global Corporate Registry Profile",
        "description": "Queries the global sandbox registry using an ISO country code plus a national registration/tax/VAT number to return corporate status and UBO shareholder details.",
        "operationId": "query_openapi_registry",
        "parameters": [
          {
            "name": "countryCode",
            "in": "path",
            "required": true,
            "description": "The ISO 2-letter uppercase country code (e.g., DE, IT).",
            "schema": { "type": "string", "example": "DE" }
          },
          {
            "name": "registrationNumber",
            "in": "path",
            "required": true,
            "description": "The target business entity's registration string, tax code, or VAT number.",
            "schema": { "type": "string", "example": "DE132490588" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful registry match returned.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "companyName": { "type": "string", "nullable": true },
                    "vatCode": { "type": "string" },
                    "businessStatus": { "type": "string" },
                    "shareholdersInformation": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "companyName": { "type": "string" },
                          "percentShare": { "type": "number" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized. Authorization header is expired, missing, or malformed."
          }
        },
        "security": [{ "apiKeyHeader": [] }]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyHeader": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header"
      }
    }
  }
}
